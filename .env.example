# Local development template. Never commit the populated .env file.
# The application reads the process environment, not .env automatically.
# Load explicitly via: uv run --env-file .env uvicorn researchpilot.api:app --host 127.0.0.1 --port 8000

# Required for live Research / Idea Check (not for offline tests or /health).
OPENAI_API_KEY=your_openai_api_key

# Optional in the current client; leave blank to omit OpenAlex authentication.
OPENALEX_API_KEY=

# Optional local paths. Relative paths are resolved from the working directory.
# RESEARCHPILOT_CACHE_DIR=.researchpilot_cache
# RESEARCHPILOT_RUN_DB=.researchpilot_cache/runs.sqlite3
